.PHONY: run run-stubbed

# Run the support orchestrator against a sample inquiry from the synthetic data.
# Honors ENABLE_AI_DEMO_MODE — stubs are used when credentials are missing.
PYTHON ?= ../../.venv/bin/python

run:
	$(PYTHON) -m orchestrators.support.orchestrator

run-stubbed:
	ENABLE_AI_DEMO_MODE=true $(PYTHON) -m orchestrators.support.orchestrator
