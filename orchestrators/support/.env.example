# Support orchestrator credentials. Every variable here MUST also appear in
# the root .env.example — this file is a strict subset.

# Required to call Claude for intent classification and response drafting.
ANTHROPIC_API_KEY=

# Required to fetch the AI Config variation and emit support.escalation /
# support.error events. Without this, the orchestrator falls back to
# v1-baseline and skips event tracking (demo mode).
LAUNCHDARKLY_SDK_KEY=

# Demo mode: blocks all external API calls (default true). When true, the
# orchestrator uses stubs for LLM calls and skips LD interactions.
ENABLE_AI_DEMO_MODE=true

# Observability — both optional.
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=support-orchestrator

# Tool credentials — all optional. Stubs are used per-tool when missing.
INTERCOM_API_KEY=
ZENDESK_API_TOKEN=
SLACK_BOT_TOKEN=
HUBSPOT_API_KEY=
